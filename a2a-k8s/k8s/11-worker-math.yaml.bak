apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker-math
  namespace: a2a-demo
spec:
  replicas: 1
  selector:
    matchLabels: { app: worker-math }
  template:
    metadata:
      labels: { app: worker-math }
    spec:
      containers:
        - name: worker-math
          image: ghcr.io/example/worker-math:latest
          ports:
            - containerPort: 8002
          env:
        - name: SERVICE_BASE_URL
          value: "http://worker-math:8002"
---
apiVersion: v1
kind: Service
metadata:
  name: worker-math
  namespace: a2a-demo
spec:
  selector:
    app: worker-math
  ports:
    - port: 8002
      targetPort: 8002
      name: http
