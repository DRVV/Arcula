apiVersion: apps/v1
kind: Deployment
metadata:
  name: worker-echo
  namespace: a2a-demo
spec:
  replicas: 1
  selector:
    matchLabels: { app: worker-echo }
  template:
    metadata:
      labels: { app: worker-echo }
    spec:
      containers:
        - name: worker-echo
          image: ghcr.io/example/worker-echo:latest
          ports:
            - containerPort: 8001
          env:
        - name: SERVICE_BASE_URL
          value: "http://worker-echo:8001"
---
apiVersion: v1
kind: Service
metadata:
  name: worker-echo
  namespace: a2a-demo
spec:
  selector:
    app: worker-echo
  ports:
    - port: 8001
      targetPort: 8001
      name: http
