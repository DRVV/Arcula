apiVersion: apps/v1
kind: Deployment
metadata:
  name: coordinator
  namespace: a2a-demo
spec:
  replicas: 1
  selector:
    matchLabels: { app: coordinator }
  template:
    metadata:
      labels: { app: coordinator }
    spec:
      containers:
        - name: coordinator
          image: ghcr.io/example/coordinator:latest
          ports:
            - containerPort: 8000
          env:
        - name: ECHO_URL
          value: "http://worker-echo:8001/a2a"
        - name: MATH_URL
          value: "http://worker-math:8002/a2a"
        - name: SERVICE_BASE_URL
          value: "http://coordinator:8000"
---
apiVersion: v1
kind: Service
metadata:
  name: coordinator
  namespace: a2a-demo
spec:
  selector:
    app: coordinator
  ports:
    - port: 8000
      targetPort: 8000
      name: http
